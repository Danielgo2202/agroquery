# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://agro:agro@localhost:5433/agroquery
# Read-only role used to execute model-generated SQL
READONLY_DATABASE_URL=postgresql://agro_reader:agro_reader@localhost:5433/agroquery
OLLAMA_HOST=http://localhost:11434
# Abort an evaluation run once its cumulative API cost exceeds this (USD)
MAX_USD=5

# Optional: any OpenAI-compatible API, e.g. a free tier (used with --provider compat).
# Groq:       COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter: COMPAT_BASE_URL=https://openrouter.ai/api/v1
# Gemini:     COMPAT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
COMPAT_NAME=groq
COMPAT_BASE_URL=https://api.groq.com/openai/v1
COMPAT_API_KEY=
COMPAT_SMALL_MODEL=
COMPAT_LARGE_MODEL=
COMPAT_MIN_INTERVAL_S=2.5
